# Copy to .env and adjust. Used both by `npm run start:dev` and docker compose.

NODE_ENV=development
PORT=3000

# Required when NODE_ENV=production (min. 16 characters). Clients send it as
# "X-API-Key: <key>" or "Authorization: Bearer <key>".
API_KEY=change-me-to-a-long-random-string
# Comma separated origins allowed to call the API from a browser, or *.
CORS_ORIGINS=*
# Swagger UI at /api: on in development, off in production unless set to true.
# SWAGGER_ENABLED=true

# PostgreSQL
POSTGRES_USER=roidota
POSTGRES_PASSWORD=roidota
POSTGRES_DB=roidota
DATABASE_URL=postgresql://roidota:roidota@localhost:5432/roidota

# MQTT broker (use MQTT_URL=mqtts://host:8883 instead for TLS)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=roidota
MQTT_PASSWORD=roidota

# S3-compatible storage (the compose stack runs Versity S3 Gateway)
S3_ENDPOINT=http://localhost:9000
# Base URL placed in the download links sent to devices. It must be reachable
# from the device network: use this machine's LAN address, never "localhost".
S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000
S3_ACCESS_KEY=roidota
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET_NAME=roidota-fw
S3_REGION=us-east-1

# Optional tuning (defaults shown)
# FIRMWARE_MAX_SIZE_BYTES=16777216
# FIRMWARE_VALIDATE_IMAGE=true
# FIRMWARE_URL_TTL_SECONDS=3600
# DEVICE_OFFLINE_AFTER_MS=90000
# DEPLOYMENT_TIMEOUT_MS=300000
